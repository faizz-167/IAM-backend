# Server
PORT=3000
NODE_ENV=development
LOG_LEVEL=debug

TRUST_PROXY=false
SHUTDOWN_TIMEOUT_MS=10000

# Auth
JWT_SECRET=replace-me-with-a-long-random-string
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN_DAYS=7

# Postgres
DATABASE_URL=postgres://postgres:postgres@localhost:5432/iam
LOG_QUERIES=false

# Redis — required: holds rate-limit counters, OTPs and the access-token denylist
REDIS_URL=redis://localhost:6379

# Comma-separated allowed browser origins
CORS_ORIGINS=http://localhost:5173

# SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="IAM <no-reply@example.com>"
EMAIL_VERIFICATION_TTL_MINUTES=15
